{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ground-truth.schema.json",
  "title": "DZ-Bench ground truth",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "dataset_revision": { "$ref": "common.schema.json#/$defs/datasetRevision" },
    "coordinate_system": { "$ref": "common.schema.json#/$defs/coordinateSystem" },
    "annotation_provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "documents": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/groundTruthDocument" }
    }
  },
  "required": ["schema_version", "dataset_revision", "coordinate_system", "annotation_provenance", "documents"]
}
