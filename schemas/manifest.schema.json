{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "DZ-Bench dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "dataset_revision": { "$ref": "common.schema.json#/$defs/datasetRevision" },
    "coordinate_system": { "$ref": "common.schema.json#/$defs/coordinateSystem" },
    "documents": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/manifestDocument" }
    },
    "reference_sources": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/referenceSource" }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema_version", "dataset_revision", "coordinate_system", "documents", "reference_sources", "notes"]
}
