datasets/**/*.PDF
datasets/**/*.png
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.tif
datasets/**/*.tiff
datasets/**/*.webp
datasets/**/*.zip
datasets/**/*.7z

